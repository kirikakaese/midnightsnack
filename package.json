{
  "name": "midnightsnack-workspace",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-or-later",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @midnightsnack/host tauri dev",
    "build:remote": "pnpm --filter @midnightsnack/remote build",
    "build:host": "pnpm build:remote && pnpm --filter @midnightsnack/host tauri build",
    "lint": "eslint . && prettier --check . && node scripts/check-spdx.mjs",
    "format": "prettier --write .",
    "check": "pnpm -r check",
    "test": "pnpm -r test",
    "gen:types": "cargo test -p midnightsnack-protocol export_bindings && node scripts/gen-protocol-index.mjs && prettier --write packages/protocol/src/generated",
    "i18n:check": "node scripts/check-i18n.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.0.0",
    "prettier": "^3.9.0",
    "prettier-plugin-svelte": "^3.5.0",
    "svelte": "^5.57.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.71.0"
  }
}
