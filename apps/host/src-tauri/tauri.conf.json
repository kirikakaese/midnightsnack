{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "midnightsnack",
  "identifier": "io.github.kirikakaese.midnightsnack",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm --dir ../.. build:remote && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "operator",
        "title": "midnightsnack",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "url": "index.html#/operator"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: http://127.0.0.1:*; media-src 'self' blob: http://127.0.0.1:*; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:* http://127.0.0.1:*; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "msi", "nsis", "dmg", "app"],
    "category": "Productivity",
    "shortDescription": "Presentation host with remote control",
    "license": "GPL-3.0-or-later",
    "licenseFile": "../../../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/pdfium/*": "pdfium/"
    },
    "linux": {
      "deb": {
        "recommends": ["libreoffice-impress"]
      }
    }
  }
}
