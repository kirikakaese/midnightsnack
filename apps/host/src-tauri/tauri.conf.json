{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DECK",
  "mainBinaryName": "deck",
  "identifier": "io.github.kirikakaese.deck",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm --dir ../.. build:remote && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "operator",
        "title": "DECK",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "url": "index.html#/operator"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: http://*:*; media-src 'self' blob: http://*:*; connect-src 'self' ipc: http://ipc.localhost ws://*:* http://*:*; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "msi", "nsis", "dmg", "app"],
    "category": "Productivity",
    "shortDescription": "DECK — presentation host with remote control",
    "longDescription": "Run presentations, PDFs, images, video, text and timers on projectors and screens, with phones and tablets as remote controls, presenter views and stage displays.",
    "publisher": "DECK contributors",
    "homepage": "https://github.com/kirikakaese/midnightsnack",
    "copyright": "Copyright © DECK contributors. Licensed under the GPL 3.0 or later.",
    "license": "GPL-3.0-or-later",
    "licenseFile": "../../../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/pdfium/*": "pdfium/"
    },
    "linux": {
      "deb": {
        "depends": ["gstreamer1.0-plugins-base", "gstreamer1.0-plugins-good"],
        "recommends": ["libreoffice-impress", "gstreamer1.0-libav", "gstreamer1.0-plugins-bad"],
        "desktopTemplate": "linux/deck.desktop",
        "files": {
          "/usr/share/mime/packages/deck.xml": "linux/deck-mime.xml"
        }
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    },
    "fileAssociations": [
      {
        "ext": ["msnack"],
        "name": "DECK show",
        "description": "DECK show",
        "role": "Editor",
        "mimeType": "application/x-midnightsnack-show",
        "exportedType": {
          "identifier": "io.github.kirikakaese.midnightsnack.show",
          "conformsTo": ["public.data", "public.archive"]
        }
      }
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "windows": {
      "nsis": {
        "languages": ["English", "German"],
        "displayLanguageSelector": false
      }
    }
  }
}
